{
  "framework": "static",
  "buildCommand": "",
  "outputDir": "public",
  "functions": {
    "api": {
      "type": "cloud-function",
      "runtime": "nodejs20"
    }
  },
  "routes": [
    {
      "match": "/api/*",
      "function": "api"
    }
  ],
  "mainlandRegions": ["ap-guangzhou"],
  "overseasRegions": ["ap-singapore"],
  "kvBindings": [
    {
      "name": "VIDEO_CACHE",
      "namespace": "VIDEO_CACHE"
    }
  ]
}
